
export default async function handler(req, res) {
  res.setHeader("Cache-Control", "no-store");

  const key = process.env.KLING_API_KEY;
  const password = process.env.KINO_APP_PASSWORD;

  if (!key) {
    return res.status(500).json({ error: "Kling API kaliti sozlanmagan." });
  }

  if (!password) {
    return res.status(503).json({ error: "Ilova paroli sozlanmagan." });
  }

  if (req.headers["x-app-password"] !== password) {
    return res.status(401).json({ error: "Parol noto‘g‘ri." });
  }

  try {
    if (req.method === "POST") {
      const { prompt, duration, aspectRatio } = req.body || {};

      if (!prompt || typeof prompt !== "string") {
        return res.status(400).json({ error: "Mavzu kiriting." });
      }

      const seconds = Number(duration);
      if (![5, 10, 15].includes(seconds)) {
        return res.status(400).json({ error: "5, 10 yoki 15 soniya tanlang." });
      }

      const ratio = ["16:9", "9:16", "1:1"].includes(aspectRatio)
        ? aspectRatio : "16:9";

      const response = await fetch(
        "https://api-singapore.klingai.com/text-to-video/kling-3.0",
        {
          method: "POST",
          headers: {
            Authorization: `Bearer ${key}`,
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            prompt: prompt.slice(0, 2500),
            settings: {
              resolution: "720p",
              aspect_ratio: ratio,
              duration: seconds,
              audio: "native",
              multi_shot: false
            },
            options: {
              watermark_info: { enabled: false }
            }
          })
        }
      );

      const data = await response.json();

      if (!response.ok || data.code !== 0) {
        return res.status(502).json({
          error: data.message || "Kling xatosi."
        });
      }

      return res.status(200).json({ task: data.data });
    }

    if (req.method === "GET") {
      const id = String(req.query.taskId || "");

      if (!/^[0-9]+$/.test(id)) {
        return res.status(400).json({ error: "Task ID noto‘g‘ri." });
      }

      const response = await fetch(
        `https://api-singapore.klingai.com/tasks?task_ids=${encodeURIComponent(id)}`,
        { headers: { Authorization: `Bearer ${key}` } }
      );

      const data = await response.json();

      if (!response.ok || data.code !== 0) {
        return res.status(502).json({ error: "Holatni tekshirib bo‘lmadi." });
      }

      return res.status(200).json({
        task: data.data?.[0] || null
      });
    }

    res.setHeader("Allow", "GET, POST");
    return res.status(405).json({ error: "Method not allowed." });

  } catch (error) {
    return res.status(500).json({ error: "Server xatosi." });
  }
}
